// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id            String   @id @default(cuid())
  doctorName    String   @db.Text
  clinicName    String
  email         String
  phone         String
  department    String
  message       String
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email])
  @@map("contact_submissions")
}

model OrderSubmission {
  id               String   @id @default(cuid())
  clientName       String   @map("client_name")
  clientPhone      String   @map("client_phone")
  clientEmail      String   @map("client_email")
  orderDescription String   @map("order_description") @db.Text
  pdfPath          String?  @map("pdf_path")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent") @db.Text
  emailSent        Boolean  @default(false) @map("email_sent")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([clientEmail])
  @@index([emailSent])
  @@map("order_submissions")
}

model CaseSubmission {
  id                            String   @id @default(cuid())
  practiceName                  String   @map("practice_name")
  patientName                   String   @map("patient_name")
  rx                            String?  @db.VarChar(200)
  todayDate                     String?  @map("today_date") @db.VarChar(50)
  returnDate                    String?  @map("return_date") @db.VarChar(50)
  shade                         String?  @db.VarChar(100)
  involvedTeeth                 Json     @map("involved_teeth")
  fixedRestorationOptions       String?  @map("fixed_restoration_options") @db.Text
  fixedSpecificInstructions     String?  @map("fixed_specific_instructions") @db.Text
  removableRestoration          String?  @map("removable_restoration") @db.Text
  removableSpecificInstructions String?  @map("removable_specific_instructions") @db.Text
  included                      Json
  additionalInstructions        String?  @map("additional_instructions") @db.Text
  ipAddress                     String?  @map("ip_address")
  userAgent                     String?  @map("user_agent") @db.Text
  createdAt                     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("case_submissions")
}