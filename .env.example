# Database
DATABASE_URL="mysql://user:password@localhost:3306/respectudental"

# Mailgun
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_domain.com
MAILGUN_FROM_EMAIL=noreply@your_domain.com
ADMIN_EMAIL=admin@your_domain.com

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# App
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://respectudental.com

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=1
RATE_LIMIT_WINDOW_MS=1000

# PDF Storage
PDF_STORAGE_PATH=/app/tmp